Content-Type: application/json
X-Request-ID: <REQ-ID:8hex>

{
  "message" : "FCM 토큰이 성공적으로 등록되었습니다.",
  "data" : {
    "id" : 2,
    "deviceId" : "snap-device-1",
    "deviceType" : "ANDROID",
    "createdAt" : "<LDT.F>"
  }
}

